# Biến môi trường cho docker-compose (trên Coolify: nhập ở Environment Variables của ứng dụng). Không đưa tệp .env thật lên git.

# Khóa ký phiên đăng nhập — chuỗi ngẫu nhiên dài (vd. openssl rand -base64 48).
# Để trống: máy chủ tự tạo 1 lần và lưu trong volume dữ liệu.
JWT_SECRET=

# true: ai cũng tự đăng ký được (người đầu tiên thành chủ; người sau phải được chủ thêm vào sổ mới thấy dữ liệu).
# Sau khi đã tạo đủ tài khoản cho nhân viên có thể đặt false.
ALLOW_SIGNUP=true

# true: CSDL chạy thử — sổ tạo ra là sổ mẫu (có nút giả lập tiền về / vận đơn). Dùng thật để false.
DEMO_MODE=false

# Số bản sao lưu CSDL hằng đêm được giữ lại (03:00, trong /data/backups)
BACKUP_KEEP_DAYS=14

# Tiền về tự động qua SePay: chuỗi bí mật tự đặt, nhập đúng chuỗi này trên SePay (kiểu xác thực API Key)
SEPAY_API_KEY=

# Nhận trạng thái vận đơn tự động từ hãng vận chuyển (BEST, SPX…)
TRACKING_WEBHOOK_SECRET=

# Thông báo đẩy lên điện thoại — tạo bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-cua-anh@gmail.com
