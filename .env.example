# Biến môi trường cho docker-compose (trên Coolify: nhập ở Environment Variables của ứng dụng). Không đưa tệp .env thật lên git.

# Khóa ký phiên đăng nhập — chuỗi ngẫu nhiên dài (vd. openssl rand -base64 48).
# Để trống: máy chủ tự tạo 1 lần và lưu trong volume dữ liệu.
JWT_SECRET=

# Tổng quản trị đầu tiên: chỉ tạo khi hệ thống CHƯA có Tổng quản trị nào. Mật khẩu ít nhất 8 ký tự, có chữ và số.
# Đăng nhập lần đầu phải đổi mật khẩu; về sau sửa ở đây KHÔNG đặt lại được mật khẩu (nên xóa ADMIN_PASSWORD sau lần đầu).
# Riêng DEMO_MODE=true (dữ liệu mẫu trên máy dev): mật khẩu luôn theo giá trị ở đây.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Địa chỉ trang web, dùng tạo link trong email (mời, quên mật khẩu, xác thực). Bản chạy thật bắt buộc.
APP_URL=https://so-ban-hang-thceramics.admirable.site

# Gửi email qua Gmail: bật Xác minh 2 bước cho Gmail, tạo "Mật khẩu ứng dụng" (16 ký tự) rồi dán vào SMTP_PASS.
# Bản chạy thật chưa khai: mời / quên mật khẩu / đổi email báo lỗi. Máy dev chưa khai: thư in ra nhật ký máy chủ.
SMTP_USER=
SMTP_PASS=
# Tên người gửi (mặc định "Sổ bán hàng <SMTP_USER>"); máy chủ khác Gmail thì khai thêm SMTP_HOST, SMTP_PORT (465)
SMTP_FROM=

# true: CSDL chạy thử — sổ tạo ra là sổ mẫu (có nút giả lập tiền về / vận đơn). Dùng thật để false.
DEMO_MODE=false

# Số bản sao lưu CSDL hằng đêm được giữ lại (03:00, trong /data/backups)
BACKUP_KEEP_DAYS=14

# Tiền về tự động qua SePay: chuỗi bí mật tự đặt, nhập đúng chuỗi này trên SePay (kiểu xác thực API Key)
SEPAY_API_KEY=

# Nhận trạng thái vận đơn tự động từ hãng vận chuyển (BEST, SPX…)
TRACKING_WEBHOOK_SECRET=

# Thông báo đẩy lên điện thoại — tạo bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email-cua-anh@gmail.com
